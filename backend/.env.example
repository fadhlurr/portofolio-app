# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="postgresql://postgres:password@localhost:5432/portfolio_db"

# Port the API server runs on
PORT=4000

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN="http://localhost:5173"

# Secret untuk sign/verify JWT — generate random 64+ char, JANGAN pakai nilai ini
JWT_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(48).toString('hex'))\""

# Optional override for DATABASE_URL, read first when present. Railway had a
# second, stale DATABASE_URL entry that shadowed the correct one at runtime;
# this name sidesteps that. Local development can ignore it.
PORTOFOLIO_DATABASE_URL=
