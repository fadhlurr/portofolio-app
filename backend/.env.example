# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="postgresql://postgres:password@localhost:5432/portfolio_db"

# Port the API server runs on
PORT=4000

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN="http://localhost:5173"

# Simple admin key used to protect write endpoints (POST/PUT/DELETE)
# Send it as header: x-admin-key: <value>
ADMIN_API_KEY="change-me-to-a-long-random-string"
